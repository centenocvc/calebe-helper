{
  "manifest_version": 3,
  "name": "Calebe Helper",
  "version": "1.5.6",
  "description": "Importação do Excel e automação assistida de DAVs no Calebe.",
  "icons": {
    "16": "icons/calweb-helper-16.png",
    "32": "icons/calweb-helper-32.png",
    "48": "icons/calweb-helper-48.png",
    "128": "icons/calweb-helper-128.png"
  },
  "action": {
    "default_title": "Importar dados do Excel",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/calweb-helper-16.png",
      "32": "icons/calweb-helper-32.png",
      "48": "icons/calweb-helper-48.png",
      "128": "icons/calweb-helper-128.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://s1.satgo.com.br/*",
    "https://appasp.sefaz.go.gov.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://s1.satgo.com.br/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://s1.satgo.com.br/*"
      ],
      "js": [
        "calebe-core.js",
        "clientedav.js",
        "clientecadastro.js",
        "clientecampos.js",
        "clienteduplicar.js",
        "clientepesquisa.js",
        "dav1.js",
        "dav_carregarmais.js",
        "dashboardatalhos.js",
        "fillexcel_modal.js",
        "novodav_emitir.js",
        "novodav.js",
        "xml-downloader.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js",
        "icons/calweb-helper-32.png"
      ],
      "matches": [
        "https://s1.satgo.com.br/*"
      ]
    }
  ],
  "version_name": "1.5.6"
}
